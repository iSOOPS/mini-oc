<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- I13：不做 App Store 分发（开发者自用工具），移除 app-sandbox。
	     根因：沙盒默认只允许读自身容器——spawn 外部二进制
	     （~/.npm-global/bin/opencode 等全局安装路径）被拒 →
	     posix_spawn EPERM（"os error 1"）。同理也阻断系统终端启动、
	     rathole 外部路径等核心功能。同类工具（FlClash 等）均不沙盒。 -->
	<!-- 出站网络：连 mini-oc-web / opencode serve -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- 入站/监听：opencode serve 与端口探测需 bind -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
